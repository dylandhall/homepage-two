{
  "name": "home-two",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "postbuild": "web-ext build --source-dir dist/home-two/browser --artifacts-dir dist --filename home-two.xpi --overwrite-dest",
    "watch": "ng build --watch --configuration development",
    "test": "NODE_OPTIONS=--no-experimental-webstorage ng test",
    "lint:extension": "web-ext lint --source-dir dist/home-two/browser",
    "install-extension": "./scripts/install-extension.sh"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "web-ext": "^10.7.0"
  }
}
